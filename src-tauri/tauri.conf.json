{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clutch",
  "version": "0.1.0",
  "identifier": "com.clutch.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Clutch",
        "width": 960,
        "height": 600,
        "minWidth": 720,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
